# .claudeignore — rutas que Claude no deberia leer en este repo
#
# NOTA IMPORTANTE: Claude Code NO lee este archivo de forma nativa. El bloqueo
# real lo aplica `permissions.deny` en .claude/settings.json, que se mantiene
# en sync con esta lista. Este archivo existe como documentacion legible del
# criterio (y por si alguna herramienta externa lo consume).
#
# Criterio: se excluye lo que es (a) enorme y regenerable, (b) binario y por lo
# tanto ilegible sin gastar contexto, o (c) secreto.
#
# Lo que a proposito NO se excluye, aunque sea pesado:
#   - migrations/          -> hay que leerlas para no repetir/romper una
#   - messages/*.json      -> i18n, se editan en casi toda feature nueva
#   - docs/*.md            -> handoffs y runbooks, es donde vive el contexto
#   - src/lib/mockData.ts  -> grande pero central para el modo demo

# ---------------------------------------------------------------------------
# (c) Secretos — lo mas importante de esta lista
# ---------------------------------------------------------------------------
# Se listan uno por uno y no como .env.* porque las reglas de deny de
# permissions.deny NO soportan negacion: un patron .env.* tambien bloquearia
# .env.example, que si conviene leer (documenta toda la arquitectura de
# integraciones del proyecto).
.env
.env.local
.env.development
.env.production
.env.test

# ---------------------------------------------------------------------------
# (a) Enorme y regenerable
# ---------------------------------------------------------------------------
node_modules/
.next/
.next-*/
out/
build/
coverage/
.turbo/
tsconfig.tsbuildinfo
package-lock.json
.git/

# Salidas de test/E2E: se regeneran corriendo la suite
test-results/
playwright-report/
blob-report/
.playwright/

# ---------------------------------------------------------------------------
# (b) Binarios — ilegibles, queman contexto sin aportar nada
# ---------------------------------------------------------------------------
# Manuales generados. Las fuentes .md SI se leen; los PDF son su output.
docs/manual/*.pdf
public/manual/*.pdf

# Imagenes y media
*.png
*.jpg
*.jpeg
*.gif
*.ico
*.webp
*.woff
*.woff2
*.ttf
*.eot
*.mp4
*.mov
*.zip
*.gz
*.parquet

# ---------------------------------------------------------------------------
# Datos de tenant en disco (adjuntos de soporte, logos). Puede contener
# informacion de clientes: no se lee salvo pedido explicito.
# ---------------------------------------------------------------------------
data/
