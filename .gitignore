# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-*/
/out/

# production
/build

# misc
.DS_Store
*.pem
/.tmp/
*.code-workspace

# videos y assets generados
/public/video-assets/
/public/videos/
/videos/
*.mp4
*.webm
*.gif


# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# playwright
/playwright-report/
/test-results/
/playwright/.auth/
/blob-report/

# typescript
*.tsbuildinfo
next-env.d.ts

# local database
mysql_data/
*.sql
# backups generados por scripts/backup-db.sh (viven solo en el VPS)
/backups/
*.sql.gz
# pero los archivos de migración explícitos SÍ deben commitearse
!migrations/*.sql
.tmp/

# Claude Code (config local de la herramienta, no del proyecto)
.claude/

# Adjuntos de soporte en dev local (SUPPORT_UPLOAD_DIR default)
data/

# ---------------------------------------------------------------------------
# Terraform
#
# El ESTADO nunca va al repo: contiene los secretos en claro que Terraform
# genera o lee (primary_access_key del storage y de Redis, la password de MySQL,
# connection strings). El estado real vive en el backend remoto de Azure
# (cscsfinopsmgmtqak5xmsa / container tfstate).
#
# .terraform.lock.hcl SÍ se commitea: fija las versiones de los providers.
# ---------------------------------------------------------------------------
**/.terraform/
*.tfstate
*.tfstate.*
errored.tfstate
tfplan
*.tfplan
