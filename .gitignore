# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ---------------------------------------------------------------------------
# Dependencias
# ---------------------------------------------------------------------------
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---------------------------------------------------------------------------
# Testing & Cobertura
# ---------------------------------------------------------------------------
/coverage
/playwright-report/
/test-results/
/playwright/.auth/
/playwright/
/blob-report/
junit.xml

# ---------------------------------------------------------------------------
# Next.js, Compiladores & Build
# ---------------------------------------------------------------------------
/.next/
/.next-*/
/out/
/build/
/dist/
.turbo/
*.tsbuildinfo
next-env.d.ts

# ---------------------------------------------------------------------------
# Sistema Operativo y Editores
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini
*.code-workspace
.idea/
.vscode/
*.swp
*.swo
*~

# ---------------------------------------------------------------------------
# Asistentes AI & Entorno Local
# ---------------------------------------------------------------------------
.claude/
.gemini/
.copilot/
.cursor/
.roo/

# ---------------------------------------------------------------------------
# Logs y Depuración
# ---------------------------------------------------------------------------
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*
*-runtime-logs.txt
*.runtime-logs.txt

# ---------------------------------------------------------------------------
# Variables de Entorno y Secretos
# ---------------------------------------------------------------------------
.env*
!.env.example
*.pem
*.key
*.crt
*.pfx

# ---------------------------------------------------------------------------
# Vercel
# ---------------------------------------------------------------------------
.vercel

# ---------------------------------------------------------------------------
# Base de Datos Local y Datos Temporales
# ---------------------------------------------------------------------------
mysql_data/
*.sql
*.sql.gz
# Excepciones: migraciones y esquemas obligatorios que SÍ van al repositorio
!migrations/*.sql
!scripts/manual-migrations/*.sql
!src/db/schema.sql
!src/modules/storage/schema.sql
/backups/
.tmp/
/.tmp/
data/

# ---------------------------------------------------------------------------
# Media, Videos y Assets Generados
# ---------------------------------------------------------------------------
/public/video-assets/
!public/video-assets/index.html
/public/videos/
*.mp4
*.webm
*.gif
test-*.pdf
test-*.png

# ---------------------------------------------------------------------------
# Terraform
#
# El ESTADO nunca va al repo: contiene los secretos en claro que Terraform
# genera o lee (primary_access_key del storage y de Redis, la password de MySQL,
# connection strings). El estado real vive en el backend remoto de Azure.
# .terraform.lock.hcl SÍ se commitea: fija las versiones de los providers.
# ---------------------------------------------------------------------------
**/.terraform/
*.tfstate
*.tfstate.*
*.tfstate.backup
errored.tfstate
tfplan
*.tfplan
.terraform.tfstate.lock.info
*.tfvars
!*.tfvars.example

# ---------------------------------------------------------------------------
# Directivas, SOPs, Skills, Agentes y Handoffs (Exclusivo Local)
# ---------------------------------------------------------------------------
directivas/
.agents/
.continue/
skills/
skills-lock.json
AGENTS.md
CLAUDE.md
.claudeignore
.rooignore
HANDOFF*.md
docs/HANDOFF*.md
docs/PROMPT*.md
docs/handoff/

