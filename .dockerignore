# Dependencias y builds — se instalan/generan dentro de la imagen.
node_modules
.next
# .next-<port>: distDir del dev server (next.config.ts usa `.next-${PORT}` con
# PORT numérico). Puede pesar decenas de GB de caché de dev; sin esta línea el
# contexto de build se infla enormemente y cada deploy transfiere de más.
.next-*
.swc

# VCS
.git
.gitignore

# Artefactos de test/cobertura — no se necesitan para el build de producción.
coverage
playwright-report
test-results
playwright/.auth

# Datos de runtime (adjuntos de soporte, logos): se persisten en volúmenes
# Docker, no deben entrar a la imagen ni al contexto de build.
data

# Docs y material que no forma parte del bundle (verificado: no se importan
# desde src/).
docs
directivas
*.md

# Editor / OS
.DS_Store
.vscode
.idea

# Secretos: NUNCA al contexto de build.
#
# Antes .env* NO estaba excluido, para que Next inlineara las NEXT_PUBLIC_ al
# compilar. El costo era que .env.production —con AZURE_CLIENT_SECRET,
# AZURE_KEYVAULT_CLIENT_SECRET, CRON_SECRET, DB_PASSWORD, GEMINI_API_KEY y el
# resto— viajaba DENTRO de la imagen publicada en el registry, al alcance de
# cualquiera con permiso de pull. Detectado 2026-07-28.
#
# Además rompía la autenticación en Azure: la app encontraba primero las
# credenciales del service principal del VPS en ese archivo y nunca usaba la
# managed identity del stamp, que sí tiene RBAC sobre el Key Vault.
#
# Las NEXT_PUBLIC_ ahora entran por --build-arg (ver Dockerfile). Son públicas
# por definición: terminan en el bundle que se sirve al browser.
.env
.env.*
!.env.example
