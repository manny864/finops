# =============================================================================
# FinOps SaaS — Variables de entorno (plantilla)
# =============================================================================
# Copiar este archivo como `.env.development` (local) o `.env.production` (VPS)
# y completar con valores reales. NUNCA commitear los .env reales — ya están
# en .gitignore. Usar `.env.example` solo como documentación de qué variables
# necesita la app.
# =============================================================================


# -----------------------------------------------------------------------------
# 1) Azure FinOps Application — App Registration de la PLATAFORMA
# -----------------------------------------------------------------------------
# Estas credenciales son del Service Principal "global" de la plataforma
# (NO de cada tenant cliente). Se usan para:
#   - Login MSAL del usuario final (NEXT_PUBLIC_CLIENT_ID).
#   - Llamadas server-side cuando no hay tenant context.
#
# Las credenciales por-tenant cliente viven en Azure Key Vault (sección 11),
# no acá.

NEXT_PUBLIC_CLIENT_ID=<APP_ID_DE_LA_PLATAFORMA>
AZURE_CLIENT_ID=<APP_ID_DE_LA_PLATAFORMA>
AZURE_CLIENT_SECRET=<SECRET_DE_LA_PLATAFORMA>
AZURE_TENANT_ID=<TENANT_ID_PROPIETARIO_PLATAFORMA>

# Partner ID (MPN) de CSCloudSolutions en Partner Center, usado por el
# link PAL (Partner Admin Link) opcional que el cliente aprueba desde
# Onboarding → Directorio de Entornos. Ver src/lib/partner/pal.ts.
PARTNER_MPN_ID=<1234567>
# Fallback opcional (alias soportado por el código para entornos locales):
# FINOPS_INFRA_PARTNER_ID=<1234567>

# Bootstrap de SuperAdmin (ver src/lib/superAdminBootstrap.ts, B-4 del
# Security Assessment 2026-07-15): el tenant_id "master" de CSCloudSolutions
# y el prefijo de email que se auto-promueven a system_role=SUPERADMIN en
# /api/onboard y /api/admin/config/users. Antes hardcodeados inline en cada
# archivo — ahora configurables/rotables sin tocar código. Si no se setean,
# usan los valores actuales de producción como default.
# SUPERADMIN_BOOTSTRAP_TENANT_ID=8b41364f-581a-4e43-b7cb-13138dac5517
# SUPERADMIN_BOOTSTRAP_EMAIL_PREFIX=mchavez


# -----------------------------------------------------------------------------
# 2) Base de Datos MySQL
# -----------------------------------------------------------------------------
# DEV   : 127.0.0.1:3307 (Docker compose en local).
# PROD  : 127.0.0.1:3306 (MySQL del VPS Hostinger).

DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=<DB_USER>
DB_PASSWORD=<DB_PASSWORD>
DB_NAME=<DB_NAME>


# -----------------------------------------------------------------------------
# 3) Cron Secret — para autenticar invocaciones del scheduler
# -----------------------------------------------------------------------------
# MUST be >=16 chars o cron/sync hace fail-closed. Generar con:
#   openssl rand -base64 32

CRON_SECRET=<CRON_SECRET_MIN_16_CHARS>

# Barrido del cron `sync` (todos opcionales — los defaults sirven).
# El barrido es secuencial por tenant. Las pausas evitan que la ráfaga de consultas
# a Cost Management dispare 429 y deje días sin escribir en CostSnapshots; el techo
# por tenant evita que UNO colgado deje sin datos a todos los que vienen detrás
# (pasó en prod el 2026-07-30). El job tiene timeout de 3600 s.
#
#   CRON_SYNC_TENANT_PACE_MS     pausa entre tenants (default 45000 = 45 s)
#   CRON_SYNC_GAP_PACE_MS        pausa antes de cada día de backfill (default 10000)
#   CRON_SYNC_PACE_BUDGET_MS     pasado este punto deja de pausar para poder
#                                terminar el barrido (default 2400000 = 40 min)
#   CRON_SYNC_TENANT_TIMEOUT_MS  techo de tiempo por tenant; 0 lo desactiva
#                                (default 360000 = 6 min)
CRON_SYNC_TENANT_PACE_MS=45000
CRON_SYNC_GAP_PACE_MS=10000
CRON_SYNC_PACE_BUDGET_MS=2400000
CRON_SYNC_TENANT_TIMEOUT_MS=360000


# -----------------------------------------------------------------------------
# 4) Paddle Billing — Sandbox o Production
# -----------------------------------------------------------------------------
# Comentar el bloque que NO uses. En dev usar SANDBOX.

# ---- PRODUCTION ----
# NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=<live_token>
# PADDLE_API_KEY=<pdl_live_apikey_*>
# PADDLE_WEBHOOK_SECRET=<pdl_ntfset_*>
# NEXT_PUBLIC_PADDLE_BUSINESS_MONTHLY=<pri_*>
# NEXT_PUBLIC_PADDLE_BUSINESS_YEARLY=<pri_*>
# NEXT_PUBLIC_PADDLE_PRO_MONTHLY=<pri_*>
# NEXT_PUBLIC_PADDLE_PRO_YEARLY=<pri_*>

# ---- SANDBOX (default dev) ----
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=<test_token>
PADDLE_API_KEY=<pdl_sdbx_apikey_*>
PADDLE_WEBHOOK_SECRET=<pdl_ntfset_*>
NEXT_PUBLIC_PADDLE_BUSINESS_MONTHLY=<pri_*>
NEXT_PUBLIC_PADDLE_BUSINESS_YEARLY=<pri_*>
NEXT_PUBLIC_PADDLE_PRO_MONTHLY=<pri_*>
NEXT_PUBLIC_PADDLE_PRO_YEARLY=<pri_*>


# -----------------------------------------------------------------------------
# 5) Email (Microsoft Graph) — para envío de notificaciones y reportes
# -----------------------------------------------------------------------------
# App Registration separado con permiso Mail.Send (Application).
# Puede ser el mismo del paso 1 si tiene los permisos.

AZURE_SENDER_EMAIL=<noreply@dominio.com>
AZURE_RECIPIENT_EMAIL=<sales@dominio.com>
# (reutiliza AZURE_TENANT_ID/AZURE_CLIENT_ID/AZURE_CLIENT_SECRET del paso 1
#  si tienen Mail.Send. Si querés un SP dedicado, descomentar:)
# MAIL_AZURE_TENANT_ID=
# MAIL_AZURE_CLIENT_ID=
# MAIL_AZURE_CLIENT_SECRET=


# -----------------------------------------------------------------------------
# 6) AI Provider (Gemini / OpenAI / Azure OpenAI)
# -----------------------------------------------------------------------------

AI_PROVIDER=google                          # google | openai | azure
GEMINI_API_KEY=<GEMINI_API_KEY>
# OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_KEY=


# -----------------------------------------------------------------------------
# 7) Redis — cache + rate limiting
# -----------------------------------------------------------------------------
# Dev: Docker localhost:6379, sin password.
# Prod: VPS con password.

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=


# ---------------------------------------------------------------------------
# 7b) Backups de MySQL (scripts/backup-db.sh — solo VPS, ver docs/runbook-restore-mysql.md)
# -----------------------------------------------------------------------------
# SAS URL del contenedor de Azure Blob para la copia off-site (permisos cw,
# solo create/write). Si está vacía, el backup queda solo local.
BACKUP_AZURE_SAS_URL=
# Ping de healthchecks.io para alertar si el backup no corre (Fase 2, opcional).
BACKUP_HEALTHCHECK_URL=

# -----------------------------------------------------------------------------
# 7c) Alertas de fallo de cron (scripts/cron-ping.sh — solo VPS, Fase 2)
# -----------------------------------------------------------------------------
# URLs de ping de healthchecks.io (gratis hasta 20), una por cron job de
# /api/cron/*. Todas opcionales e independientes: vacía = ping no-op, el cron
# sigue funcionando igual. Ver "Ejemplo crontab VPS" en README.md.
SYNC_HEALTHCHECK_URL=
PREWARM_HEALTHCHECK_URL=
POWER_SCHEDULES_HEALTHCHECK_URL=
OPEN_DATA_HEALTHCHECK_URL=
ANOMALY_DETECTION_HEALTHCHECK_URL=
COST_SYNC_STALENESS_HEALTHCHECK_URL=
TTL_EXPIRY_ALERTS_HEALTHCHECK_URL=
CREDENTIAL_EXPIRY_ALERTS_HEALTHCHECK_URL=
SUBSCRIPTION_EXPIRY_HEALTHCHECK_URL=
TRIAL_EXPIRY_HEALTHCHECK_URL=
SUPPORT_ATTACHMENTS_CLEANUP_HEALTHCHECK_URL=
STATUS_SNAPSHOT_HEALTHCHECK_URL=
FOCUS_EXPORT_DAILY_HEALTHCHECK_URL=
HISTORICAL_GAP_BACKFILL_HEALTHCHECK_URL=


# -----------------------------------------------------------------------------
# 7c) Azure Blob Storage — adjuntos de soporte y logos de tenant
# -----------------------------------------------------------------------------
# Connection string del Storage Account (Portal > Storage Account > Access
# keys > Connection string). Se migra a Key Vault como
# infra-azure-storage-connection-string (ver src/lib/secrets/infraSecrets.ts
# y scripts/migrate-infra-secrets-to-kv.ts).
#
# Si se deja vacío, cae automáticamente a filesystem local (./data/*,
# montado como volumen en Docker) — no rompe el dev local sin Storage Account.
#
# Containers (se crean solos, privados, en el primer upload — no hace falta
# crearlos a mano):
#   - tenant-logos          (logos de marca, ver src/lib/tenantLogo.ts)
#   - support-attachments   (adjuntos de tickets, ver src/lib/supportAttachments.ts)
#   - executive-reports     (reportes ejecutivos IA, ver src/lib/executiveReportStorage.ts)
AZURE_STORAGE_CONNECTION_STRING=
# Nombres de container opcionales (default: tenant-logos / support-attachments / executive-reports)
# AZURE_STORAGE_CONTAINER_LOGOS=
# AZURE_STORAGE_CONTAINER_SUPPORT_ATTACHMENTS=
# AZURE_STORAGE_CONTAINER_EXECUTIVE_REPORTS=


# -----------------------------------------------------------------------------
# 8) SSO via WorkOS
# -----------------------------------------------------------------------------
# Dev: usar test keys. Prod: rotar al sk_live_*.

WORKOS_API_KEY=<sk_test_o_sk_live>
WORKOS_CLIENT_ID=<client_*>
WORKOS_REDIRECT_URI=<https://app.tudominio.com/api/auth/sso/callback>
NEXT_PUBLIC_SSO_ENABLED=true

# Secret para firmar la cookie de state del flujo SSO (CSRF protection).
# MUST be >=32 chars. Generar con: openssl rand -hex 32
SSO_SESSION_SECRET=<HEX_64_CHARS>


# -----------------------------------------------------------------------------
# 9) SMTP — fallback para canal de email (los tenants pueden override)
# -----------------------------------------------------------------------------

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=user@example.com
SMTP_PASSWORD=<SMTP_PASSWORD>
SMTP_FROM="FinOps SaaS <noreply@example.com>"


# -----------------------------------------------------------------------------
# 10) MFA Encryption Key
# -----------------------------------------------------------------------------
# Para encriptar los TOTP seeds en DB y la cache de KV en disco.
# MUST be 32 bytes (64 chars hex). Generar con: openssl rand -hex 32
# NO rotar a la ligera: si cambia, todos los MFA actuales quedan ilegibles.

MFA_ENCRYPTION_KEY=<HEX_64_CHARS>


# -----------------------------------------------------------------------------
# 11) Azure Key Vault — almacenamiento centralizado de credenciales de tenant
# -----------------------------------------------------------------------------
# Setup completo: docs/key-vault-integration.md
#
# El Service Principal de KV (CLIENT_ID/SECRET de abajo) es DIFERENTE del
# Service Principal de la plataforma (sección 1). Este SP solo tiene acceso
# al KV para leer/escribir secrets de tenant.
#
# Permisos requeridos sobre el vault:
#   - Durante migración: "Key Vault Secrets Officer" (read+write).
#   - Después de estabilización: "Key Vault Secrets User" (read-only).
#
# ROTACIÓN: el AZURE_KEYVAULT_CLIENT_SECRET expira cada 180 días.
# Agendar recordatorio para rotar antes del vencimiento.

AZURE_KEYVAULT_URL=https://<NAME>.vault.azure.net/
AZURE_KEYVAULT_TENANT_ID=<TENANT_DEL_SP_DE_KV>
AZURE_KEYVAULT_CLIENT_ID=<APP_ID_DEL_SP_DE_KV>
AZURE_KEYVAULT_CLIENT_SECRET=<SECRET_DEL_SP_DE_KV>     # rotar cada 180d

# Feature flags
AZURE_KEYVAULT_ENABLED=true                # false = legacy mode (DB only)
AZURE_KEYVAULT_CACHE_TTL_SECONDS=1800      # 30 min — fresh cache window
AZURE_KEYVAULT_STALE_TTL_SECONDS=86400     # 24h — stale-while-revalidate fallback


# -----------------------------------------------------------------------------
# 12) Marketplace Integration (Azure)
# -----------------------------------------------------------------------------
# Dejar vacío si no operás todavía con Marketplace.
# Setup completo: docs/marketplace-integration.md

# Azure Marketplace SaaS Fulfillment API
AZURE_MARKETPLACE_AAD_TENANT_ID=
AZURE_MARKETPLACE_AAD_APP_ID=
AZURE_MARKETPLACE_AAD_APP_SECRET=
AZURE_MARKETPLACE_OFFER_ID=finops-saas-azure-offer
# (opcional) issuers extra para webhooks JWT — coma-separados
# AZURE_MARKETPLACE_TRUSTED_ISSUERS=


# -----------------------------------------------------------------------------
# 13) Webhooks — allow-list extra (Slack/Teams/etc están por default)
# -----------------------------------------------------------------------------
# Hostnames adicionales permitidos para notificaciones webhook outbound.
# Coma-separados. Si no setás, solo aplica el allow-list built-in.
# WEBHOOK_ALLOWED_HOSTS=internal.hooks.example.com,monitoring.example.com


# -----------------------------------------------------------------------------
# 14) reCAPTCHA v3 — anti-spam para formularios de leads/demos
# -----------------------------------------------------------------------------
# RECAPTCHA_SECRET es migrable a Key Vault como 'infra-recaptcha-secret'
# (scripts/migrate-infra-secrets-to-kv.ts); el .env queda como fallback.
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET=


# -----------------------------------------------------------------------------
# 15) Playwright E2E — usuario de test para login MSAL real (opcional)
# -----------------------------------------------------------------------------
# Solo necesario para el project "authenticated" (__tests__/e2e/setup/msal.setup.ts).
# Sin estas dos vars, `npm run test:e2e` corre solo la suite "demo" (sin Azure
# AD) y no falla. Poner en un .env.test local, NUNCA commitear valores reales.
# El usuario de test DEBE estar excluido de cualquier política de Conditional
# Access que exija MFA — ver docs/testing.md § E2E.
# TEST_USER_EMAIL=
# TEST_USER_PASSWORD=
# PLAYWRIGHT_BASE_URL=http://localhost:3000

# Base pública de la app, usada para armar los links de verificación de email,
# reset de contraseña e invitación. Si está mal, los mails salen con links
# rotos. Sin valor cae a https://app.cscloudsolutions.com.ar
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── WebAuthn / FIDO2 (llaves de seguridad y passkeys del 2FA de la plataforma) ──
# El rpID es el dominio registrable de la app y los orígenes son las URL exactas
# desde las que se llama al navegador. WebAuthn los valida contra lo que firmó el
# autenticador: NO se derivan de los headers del request, porque `Host` y `Origin`
# los controla el cliente y confiar en ellos anularía la protección anti-phishing.
# Sin estas variables se usa el dominio de producción por default.
WEBAUTHN_RP_ID=finops.cscloudsolutions.com.ar
WEBAUTHN_RP_NAME=CSCloudSolutions FinOps
# Lista separada por comas. Incluir staging y localhost para desarrollo.
WEBAUTHN_ORIGINS=https://finops.cscloudsolutions.com.ar,https://stagingfinops.cscloudsolutions.com.ar,http://localhost:3000

# --- Ingesta: ritmo del backfill de huecos históricos ---------------------
# Pausa en milisegundos entre cada día que rellena el backfill día por día
# (src/lib/historicalGapBackfill.ts). Default 2500.
#
# El relleno pide UN día por vez en lugar de meses enteros: son más llamadas
# pero cada una del tamaño que el cron diario ya ejecuta con éxito, y el
# progreso queda persistido aunque Cost Management empiece a devolver 429 a
# mitad de camino. Subirlo espacia más las consultas si la cuota del tenant
# está ajustada; bajarlo acelera el relleno a costa de más presión sobre la API.
GAP_BACKFILL_PACE_MS=2500

# Add-ons de capacidad (MEJ-15 fase 2).
#
# Son 4 porque cada add-on tiene un precio distinto por tier: en Paddle hay 2
# productos ("Tenant Adicional" y "Suscripción Azure Adicional") con 2 precios
# base cada uno. Enterprise no lleva: su capacidad va en el contrato.
#
# NO son secretos —un price ID viaja al navegador en cualquier checkout— así
# que van en el .env plano y NO en Key Vault. Lo que sí está en Key Vault es
# PADDLE_API_KEY (infra-paddle-api-key) y el webhook secret.
#
# Sin estos IDs el webhook NO toca la capacidad de ningún tenant: es
# deliberado, para no pisar con ceros la capacidad cargada a mano.
PADDLE_ADDON_SUBSCRIPTION_PRICE_ID_PROFESSIONAL=
PADDLE_ADDON_SUBSCRIPTION_PRICE_ID_BUSINESS=
PADDLE_ADDON_TENANT_PRICE_ID_PROFESSIONAL=
PADDLE_ADDON_TENANT_PRICE_ID_BUSINESS=
