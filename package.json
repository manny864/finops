    "verify:demo-tenant": "tsx scripts/verify-demo-tenant.ts",
    "cron:power-schedules": "bash -c 'set -a; source .env.development; set +a; curl -fsS -H \"Authorization: Bearer $CRON_SECRET\" http://localhost:3000/api/cron/power-schedules'",
