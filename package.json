{
  "name": "finops-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:clean": "lsof -ti:3000 | xargs kill -9 2>/dev/null; next dev -p 3000",
    "dev:3003": "PORT=3003 next dev -p 3003",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:demo": "playwright test --project=demo-setup --project=demo",
    "test:e2e:report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "db:delete-admin": "node scripts/delete-admin-user.js",
    "migrate": "tsx scripts/migrate.ts",
