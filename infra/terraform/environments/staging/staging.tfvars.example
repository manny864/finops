# Staging Environment — staging.tfvars
# ====================================
#
# Este archivo contiene los valores específicos para el ambiente STAGING.
# Copiar a staging.tfvars (no commitear secretos).
#
# COSTO MENSUAL ESTIMADO: ~$45-50/mes
# - MySQL B1ms: ~$30/mes
# - CAE (0.5 vCPU, 1 replica): ~$10/mes
# - Storage + Logs + misc: ~$5/mes

subscription_id = "YOUR_AZURE_SUBSCRIPTION_ID"
tenant_id       = "YOUR_AZURE_TENANT_ID"
# "stg" y no "staging": el Key Vault tiene un límite de 24 caracteres y
# cscs-finops-staging-wus2-kv son 27. Los recursos reales son cscs-finops-stg-*.
environment     = "stg"

name_prefix = "cscs"
project     = "finops"

global_location = "westus2"

# ===== ACR COMPARTIDO CON PROD =====
# Obtener del output de prod: terraform -chdir=environments/prod output
acr_name                = "cscsfinopsprodglobalcr"
acr_resource_group_name = "cscs-finops-prod-global-rg"

# ===== STAMPS =====
stamps = {
  us = {
    location       = "westus2"
    zone_redundant = false  # No HA para staging

    address_space       = ["10.1.0.0/16"]
    apps_subnet_prefix  = "10.1.0.0/24"
    pe_subnet_prefix    = "10.1.1.0/24"
    mysql_subnet_prefix = "10.1.2.0/24"

    # MySQL SEPARADA de prod
    mysql_database_name         = "finops_staging"
    mysql_admin_login           = "finops_admin"
    mysql_sku_name              = "B_Standard_B1ms"  # Burstable, más barato
    mysql_storage_gb            = 32
    mysql_backup_retention_days = 7
    mysql_geo_redundant_backup  = false
    mysql_high_availability     = false
    mysql_backup_vault_enabled  = false

    # Redis COMPARTIDO (mismo que prod, con prefijo)
    redis_sku_name                  = "Balanced_B3"
    redis_high_availability_enabled = true

    storage_replication_type      = "ZRS"
    storage_backup_retention_days = 7

    # Web: MENOS que prod
    web_cpu                         = 0.5   # 0.5 vCPU
    web_memory                      = "1Gi" # 1 GB
    web_min_replicas                = 1     # 1 replica
    web_max_replicas                = 2     # Max 2 (no escala más)
    concurrent_requests_per_replica = 20

    # Key Vault PROPIO de staging (cscs-finops-stg-wus2-kv). El ejemplo decía
    # keyvault_create = false apuntando a "cscs-finops-prod-kv", que además no
    # existe — el de prod es cscs-finops-prod-wus2-kv. Con create = false el
    # plan quiere DESTRUIR random_password.cron, que el state sí tiene.
    # Verificado contra staging/terraform.tfstate el 2026-08-22.
    keyvault_create                   = true
    keyvault_private_endpoint_enabled = false
    keyvault_network_acls_enabled     = false
    keyvault_allowed_ip_rules         = []

    monthly_budget_amount = 50

    custom_domain_enabled = false
  }
}

default_stamp = "us"

# ===== CRON JOBS =====
# En staging, ejecutar sync 1 vez al día para testing
cron_jobs = {
  sync = {
    cron            = "0 6 * * *"  # 06:00 UTC (03:00 Argentina)
    timeout_seconds = 300
    auth_mode       = "header"
    name            = "sync"
    async_poll      = false
  }
  prewarm-mysql-finops = {
    cron            = "*/20 * * * *"
    timeout_seconds = 300
    auth_mode       = "header"
    name            = "prewarm-mysql-finops"
    async_poll      = false
  }
  prewarm-cosmos-finops = {
    cron            = "*/20 * * * *"
    timeout_seconds = 300
    auth_mode       = "header"
    name            = "prewarm-cosmos-finops"
    async_poll      = false
  }
  prewarm-mongo-finops = {
    cron            = "*/20 * * * *"
    timeout_seconds = 300
    auth_mode       = "header"
    name            = "prewarm-mongo-finops"
    async_poll      = false
  }
  prewarm-sql-finops = {
    cron            = "*/20 * * * *"
    timeout_seconds = 300
    auth_mode       = "header"
    name            = "prewarm-sql-finops"
    async_poll      = false
  }
  prewarm-postgres-finops = {
    cron            = "*/20 * * * *"
    timeout_seconds = 300
    auth_mode       = "header"
    name            = "prewarm-postgres-finops"
    async_poll      = false
  }
  prewarm-storage-finops = {
    cron            = "*/20 * * * *"
    timeout_seconds = 300
    auth_mode       = "header"
    name            = "prewarm-storage-finops"
    async_poll      = false
  }
  sync-azure-ai = {
    cron            = "*/20 * * * *"  # Every 20 minutes, cache pre-warming
    timeout_seconds = 300
    auth_mode       = "header"
    name            = "sync-azure-ai"
    async_poll      = false
  }
  prewarm-security-finops = {
    cron            = "*/20 * * * *"
    timeout_seconds = 300
    auth_mode       = "header"
    name            = "prewarm-security-finops"
    async_poll      = false
  }
  # Opcionalmente, comentar otros jobs que no se usan en staging
  # prewarm-dashboard = { ... }
  # power-schedules = { ... }
}

cron_timezone_offset_hours = -3

image_name        = "finops"
migrate_image_tag = "builder"
image_tag         = "latest"
target_port       = 3000

alert_email = "operations-staging@cscloudsolutions.com.ar"

# Log Analytics
log_retention_days           = 30 # mínimo que acepta Log Analytics
log_daily_quota_gb           = 0.5
appinsights_sampling_percentage = 50

# No locks en staging (facilita testing)
resource_lock_enabled = false

# Secretos del Key Vault expuestos como env var del Container App.
#
# Van COMENTADOS, igual que en prod/terraform.tfvars.example: los ids de arriba
# tenían el placeholder YOUR_SUB y un vault inexistente
# ("cscs-finops-prod-kv"; el real es cscs-finops-prod-wus2-kv), así que el plan
# fallaba con "expected 2 or 3 path segments, found 10".
#
# Usar el id SIN versión para que rotar el secreto no exija redeploy:
#   az keyvault secret show --vault-name cscs-finops-stg-wus2-kv \
#     -n paddle-api-key --query id -o tsv
key_vault_secret_ids = {
  # paddle-api-key = "https://cscs-finops-stg-wus2-kv.vault.azure.net/secrets/paddle-api-key"
  # workos-api-key = "https://cscs-finops-stg-wus2-kv.vault.azure.net/secrets/workos-api-key"
}

key_vault_secret_env = {
  # PADDLE_API_KEY = "paddle-api-key"
  # WORKOS_API_KEY = "workos-api-key"
}

extra_env_vars = {
  NODE_ENV        = "production"
  LOG_LEVEL       = "info"
  ENVIRONMENT     = "staging"
  REDIS_PREFIX    = "staging:"  # ← Crítico: prefijo para aislar keys en Redis compartido
}

tags = {
  Environment = "STAGING"
  Criticality = "Medium"
  CostCenter  = "Engineering"
}
