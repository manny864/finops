subscription_id = "ec03e8ce-ceee-4638-b303-64ae431d5b1e" # CSCS-LandingZone
tenant_id       = "81ebe027-e6af-4e09-bc73-58c9012c6408"
environment     = "dev"
name_prefix = "cscs"
project     = "finops"
# Misma región que el stamp: un ACR lejos de las apps hace más lento el pull
# de cada revisión nueva.
global_location = "westus2"

# ---------------------------------------------------------------------------
# Stamps. La clave es el valor de Tenants.data_residency que atiende el stamp.
# Hoy uno solo: todos los tenants caen acá igual que hoy caen en el pool único
# de regionPool.ts. Agregar "eu" habilita la residencia real que el roadmap de
# docs/data-residency.md pone en Q2 2026.
# ---------------------------------------------------------------------------
stamps = {
  us = {
    # West US 2 y no East US 2: esta suscripción NO tiene capacidad de MySQL
    # Flexible en East US 2, East US ni Central US (ProvisionNotSupportedForRegion).
    location = "westus2"

    address_space       = ["10.52.0.0/16"]
    apps_subnet_prefix  = "10.52.0.0/23" # /23 o mayor: lo exige Container Apps
    pe_subnet_prefix    = "10.52.10.0/24"
    mysql_subnet_prefix = "10.52.20.0/24"

    # 48 tablas y 5 tenants hoy, con snapshots de costo creciendo a diario.
    # B2s en vez de B1ms: el sync diario y el backfill histórico son pesados.
    # HA exige GP_Standard_D2ds_v4 o superior — Burstable no la soporta.
    mysql_sku_name              = "B_Standard_B1ms"
    mysql_storage_gb            = 20
    mysql_backup_retention_days = 14
    mysql_high_availability     = false

    # Cache puro y regenerable (docs/vps-infra-improvement-plan.md). Corre como
    # Container App propio porque Azure retiró Cache for Redis Basic/Standard
    # y el reemplazo gestionado (Enterprise) arranca en ~USD 90/mes.
    redis_sku_name                  = "Balanced_B3"
    redis_high_availability_enabled = true

    web_cpu                         = 0.5
    web_memory                      = "1Gi"
    # 0 = no se paga cuando nadie usa el ambiente.
    web_min_replicas                = 0
    web_max_replicas                = 5
    concurrent_requests_per_replica = 40

    # Key Vault existente del proyecto: ya tiene las credenciales por tenant
    # (tenantCredentials.ts) y los secretos de infra (infraSecrets.ts).
    # Vault propio para no tocar los secretos de producción.
    keyvault_create = true

    monthly_budget_amount = 60
  }

  # eu = {
  #   location            = "westeurope"
  #   address_space       = ["10.51.0.0/16"]
  #   apps_subnet_prefix  = "10.51.0.0/23"
  #   pe_subnet_prefix    = "10.51.10.0/24"
  #   mysql_subnet_prefix = "10.51.20.0/24"
  #   keyvault_create     = true
  #   monthly_budget_amount = 60
  # }
}

default_stamp = "us"

# ---------------------------------------------------------------------------
# Los 14 procesos periódicos. Esto reemplaza al crontab manual del VPS, que no
# vive en git y ya causó dos incidentes de datos faltantes.
#
# OJO: Container Apps interpreta el cron en UTC. Estas expresiones son las del
# crontab del VPS tal cual; verificar con `ssh finops-vps 'date'` si ese
# crontab corre en UTC o en hora local antes del corte.
# ---------------------------------------------------------------------------
# En dev sólo los jobs que no consumen las ARM APIs de Azure de los clientes.
# Los pesados (sync, backfill, anomaly-detection) se disparan a mano cuando
# hace falta probarlos: `az containerapp job start`.
cron_timezone_offset_hours = -3

cron_jobs = {
  status-snapshot = { cron = "*/5 * * * *", timeout_seconds = 120, auth_mode = "query" }
  trial-expiry    = { cron = "0 1 * * *" }
  prewarm-mysql-finops = { cron = "*/20 * * * *", timeout_seconds = 300 }
  prewarm-postgres-finops = { cron = "*/20 * * * *", timeout_seconds = 300 }
}

acr_sku    = "Basic"
image_name = "finops"
image_tag  = "latest"

# Cloudflare ya hace WAF/TLS/CDN. Front Door recién con el segundo stamp.
frontdoor_enabled = false

# Se prende en prod: el alcance es la suscripción entera.
defender_enabled = false

# Vacío durante la validación del certificado del dominio propio; después,
# los rangos de Cloudflare para que nadie pegue al origen directo.
allowed_ip_ranges = []

# El resto del .env que NO es secreto. Los secretos van por key_vault_secret_ids.
extra_env_vars = {
  NEXT_PUBLIC_SSO_ENABLED = "true"
  # APP_BASE_URL, NEXT_PUBLIC_CLIENT_ID, AZURE_TENANT_ID, etc.
  # Local/dev fallback:
  # PARTNER_MPN_ID = "7111700"
}

# Secretos que la app lee como env var. El id sale del Key Vault existente:
#   az keyvault secret show --vault-name <vault> -n paddle-api-key --query id -o tsv
# Usar el id SIN versión para que la rotación no exija redeploy.
key_vault_secret_ids = {
  # paddle-api-key       = "https://<vault>.vault.azure.net/secrets/paddle-api-key"
  # paddle-webhook-secret = "https://<vault>.vault.azure.net/secrets/paddle-webhook-secret"
  # workos-api-key       = "https://<vault>.vault.azure.net/secrets/workos-api-key"
  # smtp-password        = "https://<vault>.vault.azure.net/secrets/smtp-password"
  # mfa-encryption-key   = "https://<vault>.vault.azure.net/secrets/mfa-encryption-key"
  # sso-session-secret   = "https://<vault>.vault.azure.net/secrets/sso-session-secret"
  # finops-infra-partner-id = "https://<vault>.vault.azure.net/secrets/finops-infra-partner-id"
}

key_vault_secret_env = {
  # PADDLE_API_KEY        = "paddle-api-key"
  # PADDLE_WEBHOOK_SECRET = "paddle-webhook-secret"
  # WORKOS_API_KEY        = "workos-api-key"
  # SMTP_PASSWORD         = "smtp-password"
  # MFA_ENCRYPTION_KEY    = "mfa-encryption-key"
  # SSO_SESSION_SECRET    = "sso-session-secret"
  # PARTNER_MPN_ID        = "finops-infra-partner-id"
}

log_retention_days = 30
log_daily_quota_gb = 1
alert_email        = "soporte@cscloudsolutions.com.ar"
budget_start_date  = "2026-08-01T00:00:00Z"

tags = {
  Owner      = "CSCS-CloudOps"
  CostCenter = "FINOPS"
  Product    = "FinOps"
}
